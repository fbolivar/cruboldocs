{
  "name": "CrubolDocs",
  "short_name": "CrubolDocs",
  "description": "Sistema de gestión: documentos, formularios e inspecciones, también sin conexión.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
