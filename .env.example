# Variables de entorno. Copiar a .env.local (local) y cargar las mismas en Vercel.
# Nunca poner valores reales en este archivo.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). Solo servidor: firmas, invitaciones, Storage, outbox, cron.
SUPABASE_SECRET_KEY=

# SMTP propio (ADR-003)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CrubolDocs <no-responder@dominio>"

# Vercel Cron → /api/cron/diario (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3001

# Límites de intentos (Upstash Redis, REST). Obligatorias en producción.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (login, recuperar, invitación). Obligatorias en producción.
# La misma secreta va en Supabase Auth > Attack Protection (CAPTCHA).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Solo si el dominio pasa por el proxy de Cloudflare. Secreto que Cloudflare inyecta en una
# Transform Rule (cabecera `x-cf-proxy-secret`); la app solo confía en `cf-connecting-ip`
# cuando este secreto coincide. Si NO se usa proxy, dejar vacío.
CF_PROXY_SECRET=
